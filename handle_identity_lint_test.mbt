// Independent original input/expected models frozen before execution. Data CC0-1.0.

///|
fn verify_handle_identity_lint(
  source : Bytes,
  expected : Array[(String, Int32, String)],
) -> Unit raise {
  for mode in [@dxf.LosslessRoundTrip, @dxf.ReadOnlyLint] {
    let doc = @dxf.DxfDocument::from_bytes(source, mode~).unwrap()
    assert_true(doc.is_complete())
    let before = doc.tags()
    let diagnostics = doc.lint()
    assert_eq(diagnostics.map(d => (d.code, d.offset, d.message)), expected)
    assert_true(diagnostics.iter().all(d => d.severity == @dxf.Error))
    assert_eq(doc.tags(), before)
    assert_eq(doc.original_bytes(), source)
    assert_eq(doc.save(), source)
  }
}

