test "round25 independent R12 classic sequence reaches real point-list consumer" {
  let doc = @dxf.DxfDocument::from_bytes(
    classic_r12_binary,
    mode=@dxf.ReadOnlyLint,
  ).unwrap()
  let sink = @adapters.GeometrySink::new()
  doc.pump_geometry(sink)
  let drawing = sink.drawing()
  assert_eq(drawing.entity_count(), 2)
  match drawing.entities[0] {
    @dxf_io.DxfPolyline(points) => {
      assert_eq(points.length(), 3)
      assert_eq(points[0].x, 1.25)
      assert_eq(points[0].y, -2.5)
      assert_eq(points[1].x, 4.5)
      assert_eq(points[1].y, 8.75)
      assert_eq(points[2].x, 9.0)
      assert_eq(points[2].y, 3.0)
    }
    _ => fail("classic POLYLINE missing")
  }
  match drawing.entities[1] {
    @dxf_io.DxfLine(start, end) => {
      assert_eq(start.x, 20.0)
      assert_eq(start.y, 21.0)
      assert_eq(end.x, 24.0)
      assert_eq(end.y, 25.0)
    }
    _ => fail("following LINE missing")
  }
  assert_eq(doc.save(), classic_r12_binary)
}

///|
test "round25 unsupported classic modes stay unprojected without rejecting source" {
  let prefix = b"0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1032\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n"
  let tail = b"0\nLINE\n10\n8\n20\n9\n11\n10\n21\n11\n0\nENDSEC\n0\nEOF\n"
  let plain_vertices = b"0\nVERTEX\n10\n1\n20\n2\n0\nVERTEX\n10\n3\n20\n4\n"
  let cases = [
    b"0\nPOLYLINE\n70\n1\n" + plain_vertices + b"0\nSEQEND\n",
    b"0\nPOLYLINE\n70\n8\n" + plain_vertices + b"0\nSEQEND\n",
    b"0\nPOLYLINE\n75\n5\n" + plain_vertices + b"0\nSEQEND\n",
    b"0\nPOLYLINE\n30\n2\n" + plain_vertices + b"0\nSEQEND\n",
    b"0\nPOLYLINE\n40\n2\n" + plain_vertices + b"0\nSEQEND\n",
    b"0\nPOLYLINE\n210\n1\n220\n0\n230\n0\n" + plain_vertices + b"0\nSEQEND\n",
    b"0\nPOLYLINE\n0\nVERTEX\n10\n1\n20\n2\n42\n0.5\n0\nVERTEX\n10\n3\n20\n4\n0\nSEQEND\n",
    b"0\nPOLYLINE\n0\nVERTEX\n70\n8\n10\n1\n20\n2\n0\nVERTEX\n10\n3\n20\n4\n0\nSEQEND\n",
    b"0\nPOLYLINE\n0\nVERTEX\n10\n1\n0\nVERTEX\n10\n3\n20\n4\n0\nSEQEND\n",
    b"0\nPOLYLINE\n" + plain_vertices,
  ]
  for body in cases {
    let source = prefix + body + tail
    let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.ReadOnlyLint).unwrap()
    let sink = @adapters.GeometrySink::new()
    doc.pump_geometry(sink)
    let drawing = sink.drawing()
    assert_eq(drawing.entity_count(), 1)
    match drawing.entities[0] {
      @dxf_io.DxfLine(start, end) => {
        assert_eq(start.x, 8.0)
        assert_eq(end.y, 11.0)
      }
      _ => fail("unsupported sequence swallowed the LINE")
    }
    assert_eq(doc.save(), source)
  }
}

///|
test "round25 classic private scope is record local and drawing snapshots stay stable" {
  let source = b"0\nSECTION\n2\nBLOCKS\n0\nPOLYLINE\n0\nVERTEX\n10\n99\n20\n99\n0\nVERTEX\n10\n98\n20\n98\n0\nSEQEND\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nVERTEX\n10\n77\n20\n77\n0\nPOLYLINE\n70\n0\n10\n0\n20\n0\n102\n{PRIVATE\n70\n8\n10\n900\n20\n900\n0\nVERTEX\n10\n2\n20\n3\n102\n{PRIVATE\n10\n99\n20\n88\n40\n7\n102\n}\n0\nVERTEX\n10\n4\n20\n5\n0\nSEQEND\n0\nLINE\n10\n8\n20\n9\n11\n10\n21\n11\n0\nENDSEC\n0\nEOF\n"
  let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.ReadOnlyLint).unwrap()
  let sink = @adapters.GeometrySink::new()
  doc.pump_geometry(sink)
  let first = sink.drawing()
  let second = sink.drawing()
  assert_eq(first.entity_count(), 2)
  assert_eq(second.entity_count(), 2)
  for drawing in [first, second] {
    match drawing.entities[0] {
      @dxf_io.DxfPolyline(points) => {
        assert_eq(points.length(), 2)
        assert_eq(points[0].x, 2.0)
        assert_eq(points[0].y, 3.0)
        assert_eq(points[1].x, 4.0)
        assert_eq(points[1].y, 5.0)
      }
      _ => fail("private fields or orphan vertices changed projection")
    }
  }
  assert_eq(doc.save(), source)
}
