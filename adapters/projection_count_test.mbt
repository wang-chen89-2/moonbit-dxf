///|
test "projection count distinguishes valid closed candidates from an empty source" {
  for source in [projection_count_ascii, projection_count_binary] {
    let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.ReadOnlyLint).unwrap()
    let full = @adapters.DxfkitSink::new()
    let sink = @adapters.GeometrySink::new()
    doc.pump_geometry(full)
    doc.pump_geometry(sink)
    let entities = full.drawing().entities().entities
    assert_eq(entities.length(), 3)
    match entities[0].geom {
      @dxfkit.Polyline(vertices~, closed~) => {
        assert_true(closed)
        assert_eq(vertices.length(), 3)
        assert_eq(vertices[2].at.x, 2.0)
        assert_eq(vertices[2].at.y, 2.0)
      }
      _ => fail("independent closed candidate was not assembled upstream")
    }
    assert_eq(sink.unprojected_classic_count(), 1)
    let drawing = sink.drawing()
    assert_eq(drawing.entity_count(), 2)
    match drawing.entities[0] {
      @dxf_io.DxfPolyline(points) => {
        assert_eq(points.length(), 2)
        assert_eq(points[0].x, 5.0)
        assert_eq(points[1].y, 8.0)
      }
      _ => fail("supported open point list changed")
    }
    match drawing.entities[1] {
      @dxf_io.DxfLine(start, end) => {
        assert_eq(start.x, 10.0)
        assert_eq(start.y, 20.0)
        assert_eq(end.x, 11.0)
        assert_eq(end.y, 21.0)
      }
      _ => fail("following LINE changed")
    }
    assert_eq(sink.unprojected_classic_count(), 1)
    assert_eq(sink.drawing().entity_count(), 2)
    assert_eq(doc.save(), source)
  }
}

///|
test "projection count is a non-consuming snapshot while classic input completes" {
  let sink = @adapters.GeometrySink::new()
  assert_eq(sink.unprojected_classic_count(), 0)
  for
    chunk in [
      b"0\nSECTION\n", b"2\nENTITIES\n", b"0\nPOLYLINE\n", b"70\n0\n", b"0\nVERTEX\n",
      b"10\n1\n", b"20\n2\n",
    ] {
    sink.write_ascii(chunk)
  }
  assert_eq(sink.unprojected_classic_count(), 1)
  assert_eq(sink.drawing().entity_count(), 0)
  assert_eq(sink.unprojected_classic_count(), 1)
  for chunk in [b"0\nVERTEX\n", b"10\n3\n", b"20\n4\n", b"0\nSEQEND\n"] {
    sink.write_ascii(chunk)
  }
  assert_eq(sink.unprojected_classic_count(), 0)
  assert_eq(sink.drawing().entity_count(), 1)
  for
    chunk in [
      b"0\nPOLYLINE\n", b"70\n1\n", b"0\nVERTEX\n", b"10\n8\n", b"20\n9\n", b"0\nVERTEX\n",
      b"10\n10\n", b"20\n11\n", b"0\nSEQEND\n", b"0\nENDSEC\n", b"0\nEOF\n",
    ] {
    sink.write_ascii(chunk)
  }
  assert_eq(sink.unprojected_classic_count(), 1)
  assert_eq(sink.drawing().entity_count(), 1)
}

///|
test "projection count reuses private102 policy and does not count unrelated kinds" {
  let source = b"0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1032\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nPOLYLINE\n70\n0\n102\n{PRIVATE\n70\n1\n102\n}\n0\nVERTEX\n10\n2\n20\n3\n0\nVERTEX\n10\n4\n20\n5\n0\nSEQEND\n0\nARC\n10\n0\n20\n0\n40\n2\n50\n0\n51\n90\n0\nENDSEC\n0\nEOF\n"
  let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.ReadOnlyLint).unwrap()
  let sink = @adapters.GeometrySink::new()
  doc.pump_geometry(sink)
  assert_eq(sink.unprojected_classic_count(), 0)
  assert_eq(sink.drawing().entity_count(), 1)
  assert_eq(sink.unprojected_classic_count(), 0)
  assert_eq(doc.save(), source)
}
