      b"\x31\x30\x30\x0a\x41\x63\x44\x62\x32\x64\x56\x65\x72\x74\x65\x78\x0a", b"\x31\x30\x0a\x34\x2e\x35\x0a",
      b"\x32\x30\x0a\x38\x2e\x37\x35\x0a", b"\x33\x30\x0a\x30\x0a", b"\x37\x30\x0a\x30\x0a",
      b"\x34\x30\x0a\x30\x0a", b"\x34\x31\x0a\x30\x0a", b"\x34\x32\x0a\x30\x0a",
      b"\x30\x0a\x56\x45\x52\x54\x45\x58\x0a", b"\x35\x0a\x41\x33\x0a", b"\x31\x30\x30\x0a\x41\x63\x44\x62\x45\x6e\x74\x69\x74\x79\x0a",
      b"\x38\x0a\x30\x0a", b"\x31\x30\x30\x0a\x41\x63\x44\x62\x56\x65\x72\x74\x65\x78\x0a",
      b"\x31\x30\x30\x0a\x41\x63\x44\x62\x32\x64\x56\x65\x72\x74\x65\x78\x0a", b"\x31\x30\x0a\x39\x0a",
      b"\x32\x30\x0a\x33\x0a", b"\x33\x30\x0a\x30\x0a", b"\x37\x30\x0a\x30\x0a",
      b"\x34\x30\x0a\x30\x0a", b"\x34\x31\x0a\x30\x0a", b"\x34\x32\x0a\x30\x0a",
    ] {
    sink.write_ascii(chunk)
  }
  assert_eq(sink.unprojected_classic_count(), 1)
  assert_eq(sink.drawing().entity_count(), 0)
  assert_eq(sink.unprojected_classic_count(), 1)
  for
    chunk in [
      b"\x30\x0a\x53\x45\x51\x45\x4e\x44\x0a", b"\x35\x0a\x41\x34\x0a", b"\x31\x30\x30\x0a\x41\x63\x44\x62\x45\x6e\x74\x69\x74\x79\x0a",
      b"\x38\x0a\x30\x0a", b"\x30\x0a\x4c\x49\x4e\x45\x0a", b"\x35\x0a\x42\x30\x0a",
      b"\x31\x30\x30\x0a\x41\x63\x44\x62\x45\x6e\x74\x69\x74\x79\x0a", b"\x38\x0a\x30\x0a",
      b"\x31\x30\x30\x0a\x41\x63\x44\x62\x4c\x69\x6e\x65\x0a", b"\x31\x30\x0a\x32\x30\x0a",
      b"\x32\x30\x0a\x32\x31\x0a", b"\x33\x30\x0a\x30\x0a", b"\x31\x31\x0a\x32\x34\x0a",
      b"\x32\x31\x0a\x32\x35\x0a", b"\x33\x31\x0a\x30\x0a", b"\x30\x0a\x45\x4e\x44\x53\x45\x43\x0a",
      b"\x30\x0a\x45\x4f\x46\x0a",
    ] {
    sink.write_ascii(chunk)
  }
  assert_eq(sink.unprojected_classic_count(), 0)
  let drawing = sink.drawing()
  assert_eq(drawing.entity_count(), 2)
  match drawing.entities[0] {
    @dxf_io.DxfPolyline(points) => {
      assert_eq(points.length(), 3)
      assert_eq(points[0].x, 1.25)
      assert_eq(points[2].y, 3.0)
    }
    _ => fail("completed linetype-only candidate was not projected")
  }
  assert_eq(sink.drawing().entity_count(), 2)
  assert_eq(sink.unprojected_classic_count(), 0)
}
