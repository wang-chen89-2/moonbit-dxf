// Complete independent input models frozen before execution. Data CC0; code MIT.

///|
fn verify_plinegen_view(source : Bytes, projected : Bool) -> Unit raise {
  for mode in [@dxf.LosslessRoundTrip, @dxf.ReadOnlyLint] {
    let doc = @dxf.DxfDocument::from_bytes(source, mode~).unwrap()
    let full = @adapters.DxfkitSink::new()
    let sink = @adapters.GeometrySink::new()
    doc.pump_geometry(full)
    doc.pump_geometry(sink)
    let upstream = full.drawing().entities().entities
    assert_eq(upstream.length(), 2)
    if projected {
      match upstream[0].geom {
        @dxfkit.Polyline(vertices~, closed~) => {
          assert_eq(closed, false)
          assert_eq(vertices.length(), 3)
          for i, (x, y) in [(1.25, -2.5), (4.5, 8.75), (9.0, 3.0)] {
            assert_eq(vertices[i].at.x, x)
            assert_eq(vertices[i].at.y, y)
          }
        }
        _ => fail("expected independent upstream straight point list")
      }
    }
    let drawing = sink.drawing()
    assert_eq(drawing.entity_count(), if projected { 2 } else { 1 })
    assert_eq(sink.unprojected_classic_count(), if projected { 0 } else { 1 })
    if projected {
      match drawing.entities[0] {
        @dxf_io.DxfPolyline(points) => {
          assert_eq(points.length(), 3)
          for i, (x, y) in [(1.25, -2.5), (4.5, 8.75), (9.0, 3.0)] {
            assert_eq(points[i].x, x)
            assert_eq(points[i].y, y)
          }
        }
        _ => fail("expected actual Point2D list")
      }
    }
    match drawing.entities[if projected { 1 } else { 0 }] {
      @dxf_io.DxfLine(start, end) => {
        assert_eq(start.x, 20.0)
        assert_eq(start.y, 21.0)
        assert_eq(start.z, 0.0)
        assert_eq(end.x, 24.0)
        assert_eq(end.y, 25.0)
        assert_eq(end.z, 0.0)
      }
      _ => fail("following LINE changed")
    }
    assert_eq(sink.drawing().entity_count(), drawing.entity_count())
    assert_eq(sink.unprojected_classic_count(), if projected { 0 } else { 1 })
    assert_eq(doc.save(), source)
  }
}

