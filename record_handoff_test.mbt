        b"\x41\x75\x74\x6f\x43\x41\x44\x20\x42\x69\x6e\x61\x72\x79\x20\x44\x58\x46\x0d\x0a\x1a\x00\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x00\x48\x45\x41\x44\x45\x52\x00\x09\x00\x24\x41\x43\x41\x44\x56\x45\x52\x00\x01\x00\x41\x43\x31\x30\x30\x39\x00\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x00\x45\x4e\x54\x49\x54\x49\x45\x53\x00\x00\x00\x4c\x49\x4e\x45\x00\x05\x00\x41\x42\x00\x66\x00\x7b\x41\x55\x44\x49\x54\x00\x05\x00\x44\x45\x41\x44\x00\x08\x00\x70\x72\x69\x76\x61\x74\x65\x00\x66\x00\x7d\x00\x64\x00\x41\x63\x44\x62\x45\x6e\x74\x69\x74\x79\x00\x08\x00\x63\x61\x66\xe9\x00\x64\x00\x41\x63\x44\x62\x4c\x69\x6e\x65\x00\x0a\x00\x00\x00\x00\x00\x00\x00\xf4\x3f\x14\x00\x00\x00\x00\x00\x00\x00\x04\xc0\x0b\x00\x00\x00\x00\x00\x00\x00\x12\x40\x15\x00\x00\x00\x00\x00\x00\x80\x21\x40\x00\x00\x43\x49\x52\x43\x4c\x45\x00\x05\x00\x41\x43\x00\x64\x00\x41\x63\x44\x62\x45\x6e\x74\x69\x74\x79\x00\x08\x00\x30\x00\x64\x00\x41\x63\x44\x62\x43\x69\x72\x63\x6c\x65\x00\x0a\x00\x00\x00\x00\x00\x00\x00\x22\x40\x14\x00\x00\x00\x00\x00\x00\x00\x24\x40\x28\x00\x00\x00\x00\x00\x00\x00\x00\x40\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x00\x45\x4f\x46\x00",
        "AB", "wire/version mismatch",
      ),
    ] {
    let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.ReadOnlyLint).unwrap()
    let error = try {
      ignore(doc.record_by_handle(query))
      ""
    } catch {
      error => "\{Repr(error)}"
    }
    assert_true(error.contains(reason))
    assert_eq(doc.original_bytes(), source)
  }
}

///|
test "record extraction does not reinterpret explicit repair-mode documents" {
  let source = b"\x30\x0a\x53\x45\x43\x54\x49\x4f\x4e\x0a\x32\x0a\x48\x45\x41\x44\x45\x52\x0a\x39\x0a\x24\x41\x43\x41\x44\x56\x45\x52\x0a\x31\x0a\x41\x43\x31\x30\x31\x35\x0a\x30\x0a\x45\x4e\x44\x53\x45\x43\x0a\x30\x0a\x53\x45\x43\x54\x49\x4f\x4e\x0a\x32\x0a\x45\x4e\x54\x49\x54\x49\x45\x53\x0a\x30\x0a\x4c\x49\x4e\x45\x0a\x35\x0a\x41\x42\x0a\x31\x30\x32\x0a\x7b\x41\x55\x44\x49\x54\x0a\x35\x0a\x44\x45\x41\x44\x0a\x38\x0a\x70\x72\x69\x76\x61\x74\x65\x0a\x31\x30\x32\x0a\x7d\x0a\x31\x30\x30\x0a\x41\x63\x44\x62\x45\x6e\x74\x69\x74\x79\x0a\x38\x0a\x63\x61\x66\xe9\x0a\x31\x30\x30\x0a\x41\x63\x44\x62\x4c\x69\x6e\x65\x0a\x31\x30\x0a\x31\x2e\x32\x35\x0a\x32\x30\x0a\x2d\x32\x2e\x35\x0a\x31\x31\x0a\x34\x2e\x35\x0a\x32\x31\x0a\x38\x2e\x37\x35\x0a\x30\x0a\x43\x49\x52\x43\x4c\x45\x0a\x35\x0a\x41\x43\x0a\x31\x30\x30\x0a\x41\x63\x44\x62\x45\x6e\x74\x69\x74\x79\x0a\x38\x0a\x30\x0a\x31\x30\x30\x0a\x41\x63\x44\x62\x43\x69\x72\x63\x6c\x65\x0a\x31\x30\x0a\x39\x2e\x30\x0a\x32\x30\x0a\x31\x30\x2e\x30\x0a\x34\x30\x0a\x32\x2e\x30\x0a\x30\x0a\x45\x4e\x44\x53\x45\x43\x0a\x30\x0a\x45\x4f\x46\x0a"
  let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.PermissiveRepair).unwrap()
  try doc.record_by_handle("AB") catch {
    @dxf.Unrepresentable(reason) =>
      assert_eq(reason, "record extraction requires a non-repair mode")
    _ => fail("wrong repair-mode error")
  } noraise {
    _ => fail("repair-mode source yielded an original-record attachment")
  }
  assert_eq(doc.original_bytes(), source)
}
