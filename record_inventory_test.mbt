// Independent complete records and raw spans, frozen before runtime. Data CC0; code MIT.

///|
fn verify_record_inventory(
  source : Bytes,
  expected : Array[(Int32, Int32, Int32, Bytes, Bytes?, Int32, Int32, Bytes)],
) -> Unit raise {
  for mode in [@dxf.LosslessRoundTrip, @dxf.ReadOnlyLint] {
    let doc = @dxf.DxfDocument::from_bytes(source, mode~).unwrap()
    let spans = doc.record_spans()
    assert_eq(spans.length(), expected.length())
    for
      i, (ordinal, start_tag, end_tag, kind, handle, offset, end_offset, raw) in expected {
      let span = spans[i]
      assert_eq(span.ordinal, ordinal)
      assert_eq(span.start_tag, start_tag)
      assert_eq(span.end_tag, end_tag)
      assert_eq(span.kind, kind)
      assert_eq(span.handle, handle)
      assert_eq(span.offset, offset)
      assert_eq(span.end_offset, end_offset)
      assert_eq(source[offset:end_offset].to_owned(), raw)
      assert_eq(doc.tags()[start_tag].code, 0)
      assert_eq(end_tag - start_tag, expected[i].2 - expected[i].1)
    }
    spans.clear()
    assert_eq(doc.record_spans().length(), expected.length())
    assert_eq(doc.original_bytes(), source)
    assert_eq(doc.save(), source)
  }
}

///|
fn verify_inventory_values(
  source : Bytes,
  expected : Array[(Int32, @dxf.TagValue)],
) -> Unit raise {
  for mode in [@dxf.LosslessRoundTrip, @dxf.ReadOnlyLint] {
    let tags = @dxf.DxfDocument::from_bytes(source, mode~).unwrap().tags()
    assert_eq(tags.length(), expected.length())
    for i, (code, value) in expected {
      assert_eq(tags[i].code, code)
      assert_eq(tags[i].value, value)
    }
  }
}

