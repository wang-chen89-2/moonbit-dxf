///|
test "APPID request and typed receiver share the exact public scope" {
  let source = ""
  let plan = @bridge.make_plan_hex(
    source, "[{\"handle\":\"f1\",\"xdata\":\"APP_B\",\"code\":1000,\"occurrence\":1,\"value\":{\"text\":\"reviewed-beta\"}},{\"handle\":\"F1\",\"xdata\":\"APP_B\",\"code\":1071,\"value\":{\"integer\":\"2000000001\"}}]",
  )
  assert_eq(
    @json.parse(plan),
    @json.parse(
      "[{\"index\":52,\"code\":1000,\"expected\":{\"text_hex\":\"6e65737465642d6f6c64\"},\"value\":{\"text_hex\":\"72657669657765642d62657461\"}},{\"index\":53,\"code\":1071,\"expected\":{\"integer\":\"123\"},\"value\":{\"integer\":\"2000000001\"}}]",
    ),
  )
  guard @json.parse(@bridge.apply_edits_hex(source, plan))
    is Json::Object(result) else {
    fail("missing rewritten result")
  }
  assert_eq(
    result.get("output_hex"),
    Some(
      Json::string(
        "",
      ),
    ),
  )
  assert_eq(
    @json.parse(
      @bridge.read_xdata_hex(
        "",
        "F1", "APP_B",
      ),
    ),
    @json.parse(
      "[{\"code\":1000,\"value\":{\"text_hex\":\"686561642d42\"}},{\"code\":1002,\"value\":{\"text_hex\":\"7b\"}},{\"code\":1000,\"value\":{\"text_hex\":\"72657669657765642d62657461\"}},{\"code\":1071,\"value\":{\"integer\":\"2000000001\"}},{\"code\":1002,\"value\":{\"text_hex\":\"7d\"}},{\"code\":1000,\"value\":{\"text_hex\":\"7461696c2d42\"}},{\"code\":1004,\"value\":{\"binary_hex\":\"0080ff\"}}]",
    ),
  )
}

///|
test "APPID option refuses contradictory types and preserves old request forms" {
  let source = ""
  for
    request in [
      "[{\"handle\":\"F1\",\"xdata\":1,\"code\":1000,\"value\":{\"text\":\"new\"}}]",
      "[{\"handle\":\"F1\",\"xdata\":\"APP_B\",\"appdata\":\"AUDIT\",\"code\":1000,\"value\":{\"text\":\"new\"}}]",
      "[{\"handle\":\"F1\",\"xdata\":\"APP_B\",\"unknown\":1,\"code\":1000,\"value\":{\"text\":\"new\"}}]",
      "[{\"handle\":\"F1\",\"xdata\":\"APP_B\",\"code\":1002,\"value\":{\"text\":\"{\"}}]",
    ] {
    assert_true(@bridge.make_plan_hex(source, request).has_prefix("ERROR:"))
  }
  assert_true(
    @bridge.read_xdata_hex(source, "F1", "app_b").has_prefix("ERROR:"),
  )
}
