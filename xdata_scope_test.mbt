        52,
      ),
    ] {
    for mode in [@dxf.LosslessRoundTrip, @dxf.ReadOnlyLint] {
      let doc = @dxf.DxfDocument::from_bytes(source, mode~).unwrap()
      let before = doc.tags()
      let data = doc.xdata_by_appid("000f1", "APP_B")
      assert_eq(data.map(t => t.code), [
        1000, 1002, 1000, 1071, 1002, 1000, 1004,
      ])
      assert_eq(data[2].value, @dxf.Text(b"nested-old"))
      assert_eq(data[3].value, @dxf.Integer(123L))
      assert_eq(data[6].value, @dxf.Binary(b"\x00\x80\xff"))
      let text = doc.value_edit_in_xdata(
        "f1",
        "APP_B",
        1000,
        @dxf.Text(b"reviewed-beta"),
        occurrence=1,
      )
      let integer = doc.value_edit_in_xdata(
        "F1",
        "APP_B",
        1071,
        @dxf.Integer(2000000001L),
      )
      assert_eq(text.index, selected_index)
      assert_eq(integer.index, selected_index + 1)
      assert_eq(text.expected, data[2].value)
      assert_eq(integer.expected, data[3].value)
      let result = doc.rewrite_values([text, integer])
      assert_eq(result.bytes, expected)
      assert_eq(result.changes.length(), 2)
      let changed = @dxf.DxfDocument::from_bytes(
        result.bytes,
        mode=@dxf.ReadOnlyLint,
      ).unwrap()
      let received = changed.xdata_by_appid("F1", "APP_B")
      assert_eq(received.map(t => (t.code, t.value)), [
        (1000, @dxf.Text(b"\x68\x65\x61\x64\x2d\x42")),
        (1002, @dxf.Text(b"\x7b")),
        (
          1000,
          @dxf.Text(b"\x72\x65\x76\x69\x65\x77\x65\x64\x2d\x62\x65\x74\x61"),
        ),
        (1071, @dxf.Integer(2000000001L)),
        (1002, @dxf.Text(b"\x7d")),
        (1000, @dxf.Text(b"\x74\x61\x69\x6c\x2d\x42")),
        (1004, @dxf.Binary(b"\x00\x80\xff")),
      ])
      assert_eq(
        changed.xdata_by_appid("F1", "APP_A").map(t => t.value),
        doc.xdata_by_appid("F1", "APP_A").map(t => t.value),
      )
      assert_eq(changed.xdata_by_appid("F2", "APP_B").map(t => t.value), [
        @dxf.Text(b"neighbor-B"),
      ])
      data.clear()
      assert_eq(doc.xdata_by_appid("F1", "APP_B").length(), 7)
      assert_eq(doc.tags(), before)
      assert_eq(doc.save(), source)
    }
  }
}

///|
test "XDATA rejects ambiguous or malformed selected applications before selection" {
  for
