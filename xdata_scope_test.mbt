  for
    (name, code, occurrence, reason) in [
      ("app_b", 1000, 0, "XDATA application not found"),
      ("APP_B", 1000, -1, "invalid XDATA field selector"),
      ("APP_B", 1000, 2147483647, "XDATA field occurrence not found"),
      ("APP_B", 999, 0, "invalid XDATA field selector"),
      ("APP_B", 1001, 0, "invalid XDATA field selector"),
      ("APP_B", 1002, 0, "invalid XDATA field selector"),
      ("APP_B", 1072, 0, "invalid XDATA field selector"),
      ("APP_B", 1040, 0, "XDATA field occurrence not found"),
    ] {
    let error = try {
      ignore(
        doc.value_edit_in_xdata(
          "F1",
          name,
          code,
          @dxf.Text(b"new"),
          occurrence~,
        ),
      )
      ""
    } catch {
      error => "\{Repr(error)}"
    }
    assert_true(error.contains(reason))
  }
  assert_eq(doc.original_bytes(), source)
}

