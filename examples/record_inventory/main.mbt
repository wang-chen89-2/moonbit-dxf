        b"\x39\x39\x39\x0d\x0a\x69\x6e\x76\x65\x6e\x74\x6f\x72\x79\x20\x70\x72\x65\x61\x6d\x62\x6c\x65\x0d\x0a\x20\x20\x30\x0d\x0a\x53\x45\x43\x54\x49\x4f\x4e\x0d\x0a\x20\x20\x32\x0d\x0a\x48\x45\x41\x44\x45\x52\x0d\x0a\x20\x20\x39\x0d\x0a\x24\x41\x43\x41\x44\x56\x45\x52\x0d\x0a\x20\x20\x31\x0d\x0a\x41\x43\x31\x30\x30\x39\x0d\x0a\x20\x20\x30\x0d\x0a\x45\x4e\x44\x53\x45\x43\x0d\x0a\x20\x20\x30\x0d\x0a\x53\x45\x43\x54\x49\x4f\x4e\x0d\x0a\x20\x20\x32\x0d\x0a\x45\x4e\x54\x49\x54\x49\x45\x53\x0d\x0a\x20\x20\x30\x0d\x0a\x4c\x49\x4e\x45\x0d\x0a\x20\x20\x38\x0d\x0a\x30\x0d\x0a\x31\x30\x0a\x34\x2e\x32\x35\x0a\x20\x32\x30\x0d\x0a\x2d\x33\x2e\x35\x0d\x0a\x20\x33\x30\x0d\x0a\x30\x0d\x0a\x20\x31\x31\x0d\x0a\x37\x0d\x0a\x20\x32\x31\x0d\x0a\x31\x31\x0d\x0a\x20\x33\x31\x0d\x0a\x30\x0d\x0a\x20\x20\x30\x0d\x0a\x45\x4e\x44\x53\x45\x43\x0d\x0a\x20\x20\x30\x0d\x0a\x45\x4f\x46\x0d\x0a\x0d\x0a\x20\x20\x0d\x0a",
        10, 6,
      ),
      (
        "binary", b"\x41\x75\x74\x6f\x43\x41\x44\x20\x42\x69\x6e\x61\x72\x79\x20\x44\x58\x46\x0d\x0a\x1a\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x48\x45\x41\x44\x45\x52\x00\x09\x24\x41\x43\x41\x44\x56\x45\x52\x00\x01\x41\x43\x31\x30\x30\x39\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x45\x4e\x54\x49\x54\x49\x45\x53\x00\x00\x4c\x49\x4e\x45\x00\x08\x30\x00\x0a\x00\x00\x00\x00\x00\x00\x02\x40\x14\x00\x00\x00\x00\x00\x00\x0c\xc0\x1e\x00\x00\x00\x00\x00\x00\x00\x00\x0b\x00\x00\x00\x00\x00\x00\x1c\x40\x15\x00\x00\x00\x00\x00\x00\x26\x40\x1f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x45\x4f\x46\x00",
        b"\x41\x75\x74\x6f\x43\x41\x44\x20\x42\x69\x6e\x61\x72\x79\x20\x44\x58\x46\x0d\x0a\x1a\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x48\x45\x41\x44\x45\x52\x00\x09\x24\x41\x43\x41\x44\x56\x45\x52\x00\x01\x41\x43\x31\x30\x30\x39\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x45\x4e\x54\x49\x54\x49\x45\x53\x00\x00\x4c\x49\x4e\x45\x00\x08\x30\x00\x0a\x00\x00\x00\x00\x00\x00\x11\x40\x14\x00\x00\x00\x00\x00\x00\x0c\xc0\x1e\x00\x00\x00\x00\x00\x00\x00\x00\x0b\x00\x00\x00\x00\x00\x00\x1c\x40\x15\x00\x00\x00\x00\x00\x00\x26\x40\x1f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x45\x4f\x46\x00",
        9, 6,
      ),
    ] {
    let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.LosslessRoundTrip).unwrap()
    let spans = doc.record_spans()
    assert_eq(spans.length(), expected_count)
    let tags = doc.tags()
    let mut selected = -1
    for span in spans {
      if span.kind == b"LINE" {
        assert_eq(span.handle, None)
        for i in span.start_tag..<span.end_tag {
          if tags[i].code == 10 {
            selected = i
          }
        }
      }
    }
    assert_eq(selected, expected_index)
    let result = doc.rewrite_values([
      {
        index: selected,
        expected_code: 10,
        expected: tags[selected].value,
        value: @dxf.RealBits(4.25.reinterpret_as_int64()),
      },
    ])
    assert_eq(result.bytes, expected_output)
    assert_eq(doc.save(), source)
    let received = @dxf.DxfDocument::from_bytes(
      result.bytes,
      mode=@dxf.ReadOnlyLint,
    ).unwrap()
    assert_eq(received.record_spans().length(), expected_count)
    assert_eq(received.tags()[selected].real(), Some(4.25))
    println(
      "case=\{label} records=\{expected_count} field_index=\{selected} output_matches=true original_preserved=true received_value_ok=true",
    )
  }
}
