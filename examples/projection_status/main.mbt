///|
fn main raise {
  let source = b"\x30\x0a\x53\x45\x43\x54\x49\x4f\x4e\x0a\x32\x0a\x48\x45\x41\x44\x45\x52\x0a\x39\x0a\x24\x41\x43\x41\x44\x56\x45\x52\x0a\x31\x0a\x41\x43\x31\x30\x33\x32\x0a\x30\x0a\x45\x4e\x44\x53\x45\x43\x0a\x30\x0a\x53\x45\x43\x54\x49\x4f\x4e\x0a\x32\x0a\x45\x4e\x54\x49\x54\x49\x45\x53\x0a\x30\x0a\x50\x4f\x4c\x59\x4c\x49\x4e\x45\x0a\x36\x36\x0a\x31\x0a\x37\x30\x0a\x31\x0a\x31\x30\x0a\x30\x0a\x32\x30\x0a\x30\x0a\x33\x30\x0a\x30\x0a\x30\x0a\x56\x45\x52\x54\x45\x58\x0a\x37\x30\x0a\x30\x0a\x31\x30\x0a\x30\x0a\x32\x30\x0a\x30\x0a\x33\x30\x0a\x30\x0a\x30\x0a\x56\x45\x52\x54\x45\x58\x0a\x37\x30\x0a\x30\x0a\x31\x30\x0a\x32\x0a\x32\x30\x0a\x30\x0a\x33\x30\x0a\x30\x0a\x30\x0a\x56\x45\x52\x54\x45\x58\x0a\x37\x30\x0a\x30\x0a\x31\x30\x0a\x32\x0a\x32\x30\x0a\x32\x0a\x33\x30\x0a\x30\x0a\x30\x0a\x53\x45\x51\x45\x4e\x44\x0a\x30\x0a\x50\x4f\x4c\x59\x4c\x49\x4e\x45\x0a\x36\x36\x0a\x31\x0a\x37\x30\x0a\x30\x0a\x31\x30\x0a\x30\x0a\x32\x30\x0a\x30\x0a\x33\x30\x0a\x30\x0a\x30\x0a\x56\x45\x52\x54\x45\x58\x0a\x37\x30\x0a\x30\x0a\x31\x30\x0a\x35\x0a\x32\x30\x0a\x36\x0a\x33\x30\x0a\x30\x0a\x30\x0a\x56\x45\x52\x54\x45\x58\x0a\x37\x30\x0a\x30\x0a\x31\x30\x0a\x37\x0a\x32\x30\x0a\x38\x0a\x33\x30\x0a\x30\x0a\x30\x0a\x53\x45\x51\x45\x4e\x44\x0a\x30\x0a\x4c\x49\x4e\x45\x0a\x31\x30\x0a\x31\x30\x0a\x32\x30\x0a\x32\x30\x0a\x31\x31\x0a\x31\x31\x0a\x32\x31\x0a\x32\x31\x0a\x30\x0a\x45\x4e\x44\x53\x45\x43\x0a\x30\x0a\x45\x4f\x46\x0a"
  let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.ReadOnlyLint).unwrap()
  let sink = @adapters.GeometrySink::new()
  doc.pump_geometry(sink)
  let drawing = sink.drawing()
  let count = sink.unprojected_classic_count()
  assert_eq(drawing.entity_count(), 2)
  assert_eq(count, 1)
  match drawing.entities[1] {
    @dxf_io.DxfLine(start, end) => {
      assert_eq(start.x, 10.0)
      assert_eq(end.y, 21.0)
    }
    _ => fail("expected the preserved LINE")
  }
  assert_eq(doc.save(), source)
  println("projected=\{drawing.entity_count()}")
  println("unprojected_classic=\{count}")
}
