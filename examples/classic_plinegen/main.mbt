    let full = @adapters.DxfkitSink::new()
    let sink = @adapters.GeometrySink::new()
    doc.pump_geometry(full)
    doc.pump_geometry(sink)
    let upstream = full.drawing().entities().entities
    let drawing = sink.drawing()
    let mut coordinates_ok = false
    if drawing.entities.length() == 2 && upstream.length() == 2 {
      match (drawing.entities[0], drawing.entities[1], upstream[0].geom) {
        (
          @dxf_io.DxfPolyline(points),
          @dxf_io.DxfLine(start, end),
          @dxfkit.Polyline(vertices~, closed~),
        ) => {
          coordinates_ok = points.length() == 3 &&
            vertices.length() == 3 &&
            !closed
          if coordinates_ok {
            for i, (x, y) in [(1.25, -2.5), (4.5, 8.75), (9.0, 3.0)] {
              coordinates_ok = coordinates_ok &&
                points[i].x == x &&
                points[i].y == y &&
                vertices[i].at.x == x &&
                vertices[i].at.y == y
            }
            coordinates_ok = coordinates_ok &&
              start.x == 20.0 &&
              start.y == 21.0 &&
              start.z == 0.0 &&
              end.x == 24.0 &&
              end.y == 25.0 &&
              end.z == 0.0
          }
        }
        _ => ()
      }
    }
    let source_preserved = doc.save() == source
    let unprojected = sink.unprojected_classic_count()
    println(
      "case=\{label} upstream=\{upstream.length()} projected=\{drawing.entity_count()} unprojected=\{unprojected} coordinates_ok=\{coordinates_ok} source_preserved=\{source_preserved}",
    )
    if !coordinates_ok || !source_preserved || unprojected != 0 {
      failed += 1
    }
  }
  println("failed_cases=\{failed}")
  if failed != 0 {
    fail("linetype-only classic profile not projected as expected")
  }
}
