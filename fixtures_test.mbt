///|
test "r12 independent fixture and every-byte chunking" {
  for size in [1, 2, 7, 31, 4096] {
    let decoder = @dxf.DxfDecoder::new()
    let mut p = 0
    let bytes = r12_fixture
    while p < bytes.length() {
      let end = (p + size).min(bytes.length())
      ignore(decoder.feed(bytes[p:end].to_owned()))
      p = end
    }
    let doc = decoder.finish()
    assert_true(doc.is_complete())
    assert_eq(doc.tags().length(), 573)
    assert_eq(doc.save(), bytes)
    assert_true(
      doc.tags().any(t => t.code == 1070 && t.integer() == Some(-32768L)),
    )
    assert_true(
      doc
      .tags()
      .any(t => {
        t.code == 1040 &&
        t.real().map(d => d.reinterpret_as_int64()) ==
        Some(-9223372036854775808L)
      }),
    )
    assert_true(!doc.lint().any(d => d.severity == @dxf.Error))
  }
}

