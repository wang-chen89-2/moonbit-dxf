      b"\x41\x75\x74\x6f\x43\x41\x44\x20\x42\x69\x6e\x61\x72\x79\x20\x44\x58\x46\x0d\x0a\x1a\x00\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x00\x48\x45\x41\x44\x45\x52\x00\x09\x00\x24\x41\x43\x41\x44\x56\x45\x52\x00\x01\x00\x41\x43\x31\x30\x31\x35\x00\x09\x00\x24\x55\x43\x53\x4e\x41\x4d\x45\x00\x02\x00\x42\x41\x53\x45\x5f\x55\x43\x53\x00\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x00\x45\x4e\x54\x49\x54\x49\x45\x53\x00\x00\x00\x4c\x49\x4e\x45\x00\x05\x00\x41\x31\x00\x64\x00\x41\x63\x44\x62\x45\x6e\x74\x69\x74\x79\x00\x08\x00\x30\x00\x64\x00\x41\x63\x44\x62\x4c\x69\x6e\x65\x00\x0a\x00\x00\x00\x00\x00\x00\x00\xf0\x3f\x14\x00\x00\x00\x00\x00\x00\x00\x00\x40\x1e\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0b\x00\x00\x00\x00\x00\x00\x00\x08\x40\x15\x00\x00\x00\x00\x00\x00\x00\x10\x40\x1f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x00\x53\x45\x43\x54\x49\x4f\x4e\x00\x02\x00\x4f\x42\x4a\x45\x43\x54\x53\x00\x00\x00\x44\x49\x43\x54\x49\x4f\x4e\x41\x52\x59\x00\x05\x00\x44\x30\x00\x4a\x01\x30\x00\x64\x00\x41\x63\x44\x62\x44\x69\x63\x74\x69\x6f\x6e\x61\x72\x79\x00\x19\x01\x01\x00\x03\x00\x41\x50\x50\x5f\x4d\x45\x54\x41\x00\x5e\x01\x42\x31\x00\x00\x00\x58\x52\x45\x43\x4f\x52\x44\x00\x05\x00\x42\x31\x00\x4a\x01\x44\x30\x00\x64\x00\x41\x63\x44\x62\x58\x72\x65\x63\x6f\x72\x64\x00\x18\x01\x01\x00\x09\x00\x75\x73\x65\x72\x2d\x6b\x65\x79\x00\x01\x00\x75\x6e\x63\x68\x61\x6e\x67\x65\x64\x2d\x6e\x6f\x74\x65\x00\x5a\x00\x7b\x00\x00\x00\x00\x00\x45\x4e\x44\x53\x45\x43\x00\x00\x00\x45\x4f\x46\x00",
    ] {
    let doc = @dxf.DxfDocument::from_bytes(source, mode=@dxf.LosslessRoundTrip).unwrap()
    let edit = doc.value_edit_by_handle("B1", 9, @dxf.Text(b"reviewed-key"))
    let stale = try {
      ignore(doc.rewrite_values([{ ..edit, expected: @dxf.Text(b"wrong"), }]))
      ""
    } catch {
      error => "\{Repr(error)}"
    }
    assert_true(stale.contains("edit precondition failed"))
    for value in [@dxf.Integer(7L), @dxf.Text(b"bad\x00key")] {
      let single = try {
        ignore(doc.rewrite_value(edit.index, value))
        ""
      } catch {
        error => "\{Repr(error)}"
      }
      let batch = try {
        ignore(doc.rewrite_values([{ ..edit, value, }]))
        ""
      } catch {
        error => "\{Repr(error)}"
      }
      assert_true(single.contains("Unrepresentable"))
      assert_true(batch.contains("Unrepresentable"))
    }
    if !doc.is_binary() {
      let error = try {
        ignore(doc.rewrite_values([{ ..edit, value: @dxf.Text(b"bad\nkey"), }]))
        ""
      } catch {
        error => "\{Repr(error)}"
      }
      assert_true(error.contains("text contains wire delimiter"))
    }
    assert_eq(doc.save(), source)
  }
