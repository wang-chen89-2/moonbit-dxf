        "B1",
        9,
        @dxf.Text(replacement),
        occurrence~,
      )
      assert_eq(edit.index, index)
      assert_eq(edit.expected, @dxf.Text(old))
      assert_eq(doc.rewrite_value(index, edit.value), expected)
      let result = doc.rewrite_values([edit])
      assert_eq(result.bytes, expected)
      assert_eq(result.changes.length(), 1)
      let received = @dxf.DxfDocument::from_bytes(
        result.bytes,
        mode=@dxf.ReadOnlyLint,
      ).unwrap()
      assert_eq(received.tags()[index].value, @dxf.Text(replacement))
      assert_eq(received.acad_version(), "AC1015")
      assert_eq(doc.tags(), before)
      assert_eq(doc.save(), source)
    }
  }
